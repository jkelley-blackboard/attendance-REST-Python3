# Blackboard Learn REST credentials for batch_attendance3.py
# Copy to .env (or internal/.env) and fill in. Never commit the filled-in copy.
#
# Register a REST Integration at https://developer.blackboard.com and apply the
# application key to your Learn site under System Admin > REST API Integrations.

# Bare hostname, no scheme. Example: mysite.blackboard.com
BB_HOST=

# Application key and secret from the developer portal.
# No spaces; the secret is at least 32 characters.
BB_KEY=
BB_SECRET=

# REST result limit per page. Max/default 100. Lower it to exercise paging
# when your sample courses have few records. Valid range 1-100.
BB_RESULT_LIMIT=100

# How many seconds before token expiry to re-authenticate. Use a larger value
# if you expect long delays between requests. Recommend 10 to 120.
BB_SESSION_BUFFER=30
